<Window x:Class="YandexMailCleaner.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Яндекс.Почта — очистка"
        Icon="app.ico"
        Width="900" Height="780"
        ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="14"
        Background="{StaticResource PageBackgroundBrush}"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        TextOptions.TextFormattingMode="Display">

    <Grid>
        <!-- ЭКРАН ВХОДА -->
        <Grid x:Name="LoginPanel">
            <Border Width="470" Padding="34"
                    Background="{StaticResource SurfaceBrush}"
                    CornerRadius="20"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="34" ShadowDepth="6" Opacity="0.10" Color="#1F2328" />
                </Border.Effect>

                <StackPanel>
                    <Border Width="52" Height="52" CornerRadius="16"
                            Background="{StaticResource AccentBrush}"
                            HorizontalAlignment="Left">
                        <TextBlock Text="Я" Foreground="White" FontSize="28" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="Яндекс.Почта" FontSize="26" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" Margin="0,20,0,0" />
                    <TextBlock Text="Очистка ящика от старых писем"
                               Foreground="{StaticResource TextSecondaryBrush}" FontSize="14"
                               Margin="0,4,0,26" />

                    <TextBlock Text="Электронная почта" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="LoginEmail" Margin="0,6,0,16" />

                    <Grid Margin="0,0,0,6">
                        <TextBlock Text="Пароль приложения" Style="{StaticResource FieldLabel}" />
                        <TextBlock HorizontalAlignment="Right">
                            <Hyperlink Click="HowToLink_Click">Где взять?</Hyperlink>
                        </TextBlock>
                    </Grid>
                    <PasswordBox x:Name="LoginPassword" Margin="0,0,0,8" />

                    <TextBlock x:Name="LoginError" Foreground="#DC2626"
                               TextWrapping="Wrap" LineHeight="20" Margin="0,10,0,0" />

                    <Button x:Name="ConnectButton" Content="Подключиться"
                            Style="{StaticResource PrimaryButton}"
                            Height="48" Margin="0,18,0,0"
                            HorizontalAlignment="Stretch"
                            Click="ConnectButton_Click" />

                    <TextBlock Text="Данные для входа хранятся только на этом компьютере."
                               Style="{StaticResource Hint}"
                               HorizontalAlignment="Center" TextAlignment="Center"
                               Margin="0,16,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ОСНОВНОЙ ЭКРАН -->
        <Grid x:Name="MainPanel" Visibility="Collapsed">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Шапка -->
            <Grid Grid.Row="0" Margin="30,26,30,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Text="Яндекс.Почта — очистка" FontSize="22" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimaryBrush}" />
                    <Border Background="{StaticResource SurfaceBrush}"
                            BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="8" Padding="10,5" Margin="0,10,0,0"
                            HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal">
                            <Ellipse Width="8" Height="8" Fill="#22C55E"
                                     VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBlock x:Name="AccountText" FontSize="13"
                                       Foreground="{StaticResource TextSecondaryBrush}"
                                       TextTrimming="CharacterEllipsis" MaxWidth="430" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <Button x:Name="ChangeAccountButton" Grid.Column="1"
                        Content="Сменить аккаунт" VerticalAlignment="Top"
                        Click="ChangeAccount_Click" />
            </Grid>

            <ScrollViewer Grid.Row="1" Margin="30,22,30,26"
                          VerticalScrollBarVisibility="Hidden"
                          HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <!-- Папки -->
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Border Width="26" Height="26" CornerRadius="8"
                                        Background="{StaticResource AccentSoftBrush}"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="1" FontSize="13" FontWeight="SemiBold"
                                               Foreground="{StaticResource AccentBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="Папки для очистки" Style="{StaticResource CardTitle}" />
                                    <TextBlock Text="Отметьте папки, в которых нужно искать письма"
                                               Style="{StaticResource Muted}" FontSize="12" Margin="0,2,0,0" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                                    <TextBlock Text="Отмечено:" Style="{StaticResource Muted}"
                                               VerticalAlignment="Center" />
                                    <TextBlock x:Name="SelectedCountText" Text="0" FontWeight="SemiBold"
                                               Foreground="{StaticResource TextPrimaryBrush}"
                                               VerticalAlignment="Center" Margin="5,0,0,0" />
                                    <Button Content="Все" Padding="10,5" FontSize="13" Margin="16,0,0,0"
                                            ToolTip="Выбрать все папки" Click="SelectAll_Click" />
                                    <Button Content="Снять" Padding="10,5" FontSize="13" Margin="8,0,0,0"
                                            ToolTip="Снять все отметки" Click="UnselectAll_Click" />
                                </StackPanel>
                            </Grid>

                            <Border Background="#FAFBFC" BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1" CornerRadius="12" Padding="14,8" Margin="0,16,0,0">
                                <ScrollViewer MaxHeight="180" VerticalScrollBarVisibility="Hidden">
                                    <ItemsControl x:Name="FoldersItems">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <CheckBox Content="{Binding DisplayName}"
                                                          IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                                          Checked="FolderCheck_Changed"
                                                          Unchecked="FolderCheck_Changed"
                                                          Margin="4,6" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- Период и размер -->
                    <Grid Margin="0,16,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="16" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="8"
                                            Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="2" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Период" Style="{StaticResource CardTitle}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Возраст писем или точный диапазон дат"
                                           Style="{StaticResource Muted}" FontSize="12"
                                           Margin="0,8,0,12" />

                                <ComboBox x:Name="DateModeCombo"
                                          SelectionChanged="DateModeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Старше 1 месяца" />
                                    <ComboBoxItem Content="Старше 3 месяцев" />
                                    <ComboBoxItem Content="Старше 6 месяцев" />
                                    <ComboBoxItem Content="Старше 1 года" />
                                    <ComboBoxItem Content="Всё время" />
                                    <ComboBoxItem Content="Период с … по …" />
                                </ComboBox>

                                <Grid x:Name="RangePanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <DatePicker x:Name="DateFrom" Grid.Column="0" SelectedDateFormat="Short" />
                                    <TextBlock Grid.Column="1" Text="—" Margin="8,0"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                    <DatePicker x:Name="DateTo" Grid.Column="2" SelectedDateFormat="Short" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Border Width="26" Height="26" CornerRadius="8"
                                            Background="{StaticResource AccentSoftBrush}">
                                        <TextBlock Text="3" FontSize="13" FontWeight="SemiBold"
                                                   Foreground="{StaticResource AccentBrush}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <TextBlock Text="Размер" Style="{StaticResource CardTitle}"
                                               Margin="10,0,0,0" VerticalAlignment="Center" />
                                </StackPanel>
                                <TextBlock Text="Отбирать только тяжёлые письма"
                                           Style="{StaticResource Muted}" FontSize="12"
                                           Margin="0,8,0,12" />

                                <ComboBox x:Name="SizeCombo"
                                          SelectionChanged="SizeCombo_SelectionChanged">
                                    <ComboBoxItem Content="Размер не важен" />
                                    <ComboBoxItem Content="Больше указанного" />
                                </ComboBox>

                                <StackPanel x:Name="SizePanel" Orientation="Horizontal"
                                            Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBox x:Name="SizeMb" Width="100" Text="10" />
                                    <TextBlock Text="МБ" VerticalAlignment="Center" Margin="10,0,0,0"
                                               Foreground="{StaticResource TextSecondaryBrush}" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Действие -->
                    <Button x:Name="DeleteButton"
                            Style="{StaticResource PrimaryButton}"
                            Height="50" Margin="0,16,0,0"
                            HorizontalAlignment="Stretch"
                            Click="DeleteButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="16"
                                       VerticalAlignment="Center" Margin="0,0,10,0" />
                            <TextBlock Text="Переместить в Корзину" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>

                    <!-- Прогресс и статус -->
                    <StackPanel Margin="0,14,0,0">
                        <ProgressBar x:Name="OperationProgress" Minimum="0" Maximum="100"
                                     Visibility="Collapsed" Margin="0,0,0,8" />
                        <TextBlock x:Name="StatusText" Style="{StaticResource Muted}"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <TextBlock Margin="0,18,0,0"
                               Foreground="{StaticResource TextMutedBrush}" FontSize="12"
                               TextWrapping="Wrap"
                               Text="Письма перемещаются в Корзину и остаются восстановимыми. Проверить можно на mail.yandex.ru." />
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <!-- Оверлей занятости -->
        <Grid x:Name="BusyOverlay" Visibility="Collapsed" Background="#B8F4F5F7">
            <Border Background="{StaticResource SurfaceBrush}" CornerRadius="18"
                    Padding="28,24" Width="420"
                    HorizontalAlignment="Center" VerticalAlignment="Center">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="30" ShadowDepth="6" Opacity="0.20" Color="#1F2328" />
                </Border.Effect>

                <StackPanel>
                    <TextBlock x:Name="BusyText" Text="Подождите…"
                               FontSize="16" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"
                               TextWrapping="Wrap" />
                    <TextBlock Text="Это может занять несколько минут."
                               Style="{StaticResource Muted}" Margin="0,6,0,16" />
                    <ProgressBar IsIndeterminate="True" Height="6" />
                    <Button x:Name="CancelBusyButton" Content="Отмена"
                            HorizontalAlignment="Right" Margin="0,20,0,0"
                            Click="CancelBusy_Click" />
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
